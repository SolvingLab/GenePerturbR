# Find TP53 datasets
tp53_datasets <- gpdb_list_datasets(gene = "TP53")
selected_ids <- head(tp53_datasets$dataset_id, 3)

# Batch load DEG results with progress bar
batch_deg <- gpdb_load_batch(
  dataset_ids = selected_ids,
  type = "deg",
  show_progress = TRUE
)

# Check structure
